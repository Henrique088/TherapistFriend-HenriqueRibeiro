{
  "name": "backend_express",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node dist/src/server",
    "start:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand ",
    "test:watch": "jest --watch",
    "build": "npx tsc",
    "copy-protos": "cp -r src/infrastructure/grpc/proto dist/src/infrastructure/grpc/",
    "build:full": "npm run build && npm run copy-protos",
    "seed:especialidades": "ts-node src/infrastructure/database/seeders/especialidades.seed.ts",
    "seed:usuariosProfissionais": "ts-node src/infrastructure/database/seeders/usuariosProfissionais.seed.ts",
    "seed:profissionais": "ts-node src/infrastructure/database/seeders/profissionais.seed.ts",
    "seed:profissionaisEspecialidades": "ts-node src/infrastructure/database/seeders/profissionaisEspecialidades.seed.ts",
    "admin:create": "ts-node scripts/create-admin.ts"
  },
  "setupFilesAfterEnv": [
    "./tests/setup.js"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@bull-board/api": "^8.5.0",
    "@bull-board/express": "^8.5.0",
    "awilix": "^12.0.5",
    "axios": "^1.12.2",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.61.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "deep-email-validator": "^0.1.21",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.3.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.11",
    "pg": "^8.15.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1",
    "twilio": "^5.10.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^7.0.5",
    "@types/socket.io-client": "^1.4.36",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
